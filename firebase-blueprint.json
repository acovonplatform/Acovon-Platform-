{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Core user account document stored at /users/{uid}. Contains non-PII account profile fields and RBAC state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "full_legal_name": {
          "type": "string",
          "description": "User full legal name.",
          "minLength": 2,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase alphanumeric handle.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Platform role. Must be 'fan' on self-registration; only Admins or trusted Cloud Functions can elevate to 'creator' or 'admin'.",
          "enum": ["fan", "creator", "admin"],
          "maxLength": 16
        },
        "account_status": {
          "type": "string",
          "description": "Lifecycle status of the account.",
          "enum": ["active", "suspended", "disabled", "pending_deletion"],
          "maxLength": 24
        },
        "email_verified": {
          "type": "boolean",
          "description": "Whether the user's email address is verified."
        },
        "profile_picture_url": {
          "type": "string",
          "description": "URL or storage path for the user's avatar.",
          "maxLength": 1024
        },
        "preferred_language": {
          "type": "string",
          "description": "Preferred ISO language code (e.g. en, ar, fr).",
          "minLength": 2,
          "maxLength": 16
        },
        "appearance_preference": {
          "type": "string",
          "description": "Theme mode preference.",
          "enum": ["light", "dark", "system"],
          "maxLength": 16
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server timestamp when the profile was created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest profile update."
        },
        "last_login_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent login."
        }
      },
      "required": [
        "uid",
        "full_legal_name",
        "username",
        "role",
        "account_status",
        "email_verified",
        "profile_picture_url",
        "preferred_language",
        "appearance_preference",
        "created_at",
        "updated_at",
        "last_login_at"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII document stored at /users/{uid}/private/{docId} containing email and compliance attestations.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User private email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "is_18_plus_confirmed": {
          "type": "boolean",
          "description": "Mandatory 18+ age verification attestation."
        },
        "terms_accepted": {
          "type": "boolean",
          "description": "Mandatory Terms & Privacy acceptance flag."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable creation server timestamp."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "uid",
        "email",
        "is_18_plus_confirmed",
        "terms_accepted",
        "created_at",
        "updated_at"
      ]
    },
    "UserFileMetadata": {
      "title": "UserFileMetadata",
      "description": "Metadata record for a file uploaded to Firebase Cloud Storage under /users/{uid}/files/{fileId}.",
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "description": "Unique identifier for the file.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "owner_uid": {
          "type": "string",
          "description": "Firebase UID of the file owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "original_filename": {
          "type": "string",
          "description": "Sanitized original file name.",
          "minLength": 1,
          "maxLength": 255
        },
        "storage_path": {
          "type": "string",
          "description": "Canonical Cloud Storage path under users/{uid}/files/{fileId}/{filename}.",
          "minLength": 5,
          "maxLength": 512
        },
        "mime_type": {
          "type": "string",
          "description": "Validated MIME type of the uploaded file.",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "video/mp4",
            "video/quicktime",
            "video/webm",
            "application/pdf"
          ],
          "maxLength": 64
        },
        "file_extension": {
          "type": "string",
          "description": "Normalized lowercase file extension.",
          "enum": ["jpg", "jpeg", "png", "webp", "mp4", "mov", "webm", "pdf"],
          "maxLength": 16
        },
        "file_size_bytes": {
          "type": "number",
          "description": "Size of the file in bytes (must be > 0 and <= 524288000)."
        },
        "file_category": {
          "type": "string",
          "description": "High-level media category.",
          "enum": ["image", "video", "document"],
          "maxLength": 24
        },
        "upload_status": {
          "type": "string",
          "description": "Lifecycle upload state.",
          "enum": ["uploading", "completed", "failed", "deleted"],
          "maxLength": 24
        },
        "visibility": {
          "type": "string",
          "description": "Access control tier for the file.",
          "enum": [
            "private",
            "public",
            "followers",
            "subscribers",
            "ppv",
            "message_attachment"
          ],
          "maxLength": 32
        },
        "download_url": {
          "type": "string",
          "description": "Optional preview/download URL for authorized owner session.",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server timestamp when the metadata record was created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last status/visibility update."
        },
        "deleted_at": {
          "type": "string",
          "description": "Optional ISO timestamp or empty string when soft-deleted.",
          "maxLength": 64
        }
      },
      "required": [
        "file_id",
        "owner_uid",
        "original_filename",
        "storage_path",
        "mime_type",
        "file_extension",
        "file_size_bytes",
        "file_category",
        "upload_status",
        "visibility",
        "created_at",
        "updated_at"
      ]
    },
    "UserAccountSettings": {
      "title": "UserAccountSettings",
      "description": "User preferences stored at /users/{uid}/settings/{settingId}.",
      "type": "object",
      "properties": {
        "owner_uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appearance_preference": {
          "type": "string",
          "enum": ["light", "dark", "system"],
          "maxLength": 16
        },
        "preferred_language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "language_mode": {
          "type": "string",
          "enum": ["automatic", "manual", "english"],
          "maxLength": 16
        },
        "notifications_enabled": {
          "type": "boolean"
        },
        "email_notifications": {
          "type": "boolean"
        },
        "privacy_hide_online_status": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "owner_uid",
        "appearance_preference",
        "preferred_language",
        "language_mode",
        "notifications_enabled",
        "email_notifications",
        "privacy_hide_online_status",
        "created_at",
        "updated_at"
      ]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Global uniqueness lock for usernames at /usernames/{username}.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["username", "uid", "created_at"]
    },
    "AdminOperatorRecord": {
      "title": "AdminOperatorRecord",
      "description": "Trusted admin registry document at /admins/{adminUid}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "permission_level": {
          "type": "string",
          "enum": ["super_admin", "admin", "moderator", "finance_admin", "support_admin"],
          "maxLength": 32
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "permission_level", "created_at"]
    },
    "AccountDeletionRequest": {
      "title": "AccountDeletionRequest",
      "description": "Audited user request for account deletion and personal data scrubbing at /account_deletion_requests/{requestId}.",
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "completed", "cancelled"],
          "maxLength": 24
        },
        "preserve_financial_records": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "request_id",
        "uid",
        "reason",
        "status",
        "preserve_financial_records",
        "created_at",
        "updated_at"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Primary user profile document indexed by Firebase Auth UID."
    },
    "/users/{uid}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection for the user's email and legal attestations."
    },
    "/users/{uid}/files/{fileId}": {
      "schema": { "$ref": "#/entities/UserFileMetadata" },
      "description": "User's uploaded file metadata records."
    },
    "/users/{uid}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserAccountSettings" },
      "description": "User's persisted appearance, localization, notification, and privacy preferences."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique username reservation registry."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminOperatorRecord" },
      "description": "Trusted administrator lookup collection."
    },
    "/account_deletion_requests/{requestId}": {
      "schema": { "$ref": "#/entities/AccountDeletionRequest" },
      "description": "User-submitted account deletion and GDPR/CCPA data erasure requests."
    }
  }
}
