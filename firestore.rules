rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 1. GLOBAL SAFETY NET (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. HARDENED PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Bootstrapped Admin (acovonplatform@gmail.com) or trusted /admins/{uid} document
    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'acovonplatform@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Master Gate: Verify parent user account exists and is active
    function isActiveUserAccount(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.account_status == 'active';
    }

    // =========================================================================
    // 3. VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'full_legal_name',
          'username',
          'role',
          'account_status',
          'email_verified',
          'profile_picture_url',
          'preferred_language',
          'appearance_preference',
          'created_at',
          'updated_at',
          'last_login_at'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'full_legal_name',
          'username',
          'role',
          'account_status',
          'email_verified',
          'profile_picture_url',
          'preferred_language',
          'appearance_preference',
          'created_at',
          'updated_at',
          'last_login_at'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.full_legal_name is string && data.full_legal_name.size() >= 2 && data.full_legal_name.size() <= 120 &&
        data.username is string && data.username.size() >= 3 && data.username.size() <= 40 && data.username.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role is string && data.role.size() <= 16 && data.role in ['fan', 'creator', 'admin'] &&
        data.account_status is string && data.account_status.size() <= 24 && data.account_status in ['active', 'suspended', 'disabled', 'pending_deletion'] &&
        data.email_verified is bool &&
        data.profile_picture_url is string && data.profile_picture_url.size() <= 1024 &&
        data.preferred_language is string && data.preferred_language.size() >= 2 && data.preferred_language.size() <= 16 &&
        data.appearance_preference is string && data.appearance_preference.size() <= 16 && data.appearance_preference in ['light', 'dark', 'system'] &&
        data.created_at is timestamp &&
        data.updated_at is timestamp &&
        data.last_login_at is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'is_18_plus_confirmed',
          'terms_accepted',
          'created_at',
          'updated_at'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'is_18_plus_confirmed',
          'terms_accepted',
          'created_at',
          'updated_at'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.is_18_plus_confirmed is bool && data.is_18_plus_confirmed == true &&
        data.terms_accepted is bool && data.terms_accepted == true &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidUserFileMetadata(data) {
      return data.keys().hasAll([
          'file_id',
          'owner_uid',
          'original_filename',
          'storage_path',
          'mime_type',
          'file_extension',
          'file_size_bytes',
          'file_category',
          'upload_status',
          'visibility',
          'created_at',
          'updated_at'
        ]) &&
        data.keys().hasOnly([
          'file_id',
          'owner_uid',
          'original_filename',
          'storage_path',
          'mime_type',
          'file_extension',
          'file_size_bytes',
          'file_category',
          'upload_status',
          'visibility',
          'download_url',
          'created_at',
          'updated_at',
          'deleted_at'
        ]) &&
        data.file_id is string && data.file_id.size() >= 1 && data.file_id.size() <= 128 && data.file_id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.owner_uid is string && data.owner_uid.size() >= 1 && data.owner_uid.size() <= 128 && data.owner_uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.original_filename is string && data.original_filename.size() >= 1 && data.original_filename.size() <= 255 &&
        data.storage_path is string && data.storage_path.size() >= 5 && data.storage_path.size() <= 512 &&
        data.mime_type is string && data.mime_type.size() <= 64 && data.mime_type in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'video/mp4',
          'video/quicktime',
          'video/webm',
          'application/pdf'
        ] &&
        data.file_extension is string && data.file_extension.size() <= 16 && data.file_extension in [
          'jpg', 'jpeg', 'png', 'webp', 'mp4', 'mov', 'webm', 'pdf'
        ] &&
        data.file_size_bytes is int && data.file_size_bytes > 0 && data.file_size_bytes <= 524288000 &&
        data.file_category is string && data.file_category.size() <= 24 && data.file_category in ['image', 'video', 'document'] &&
        data.upload_status is string && data.upload_status.size() <= 24 && data.upload_status in ['uploading', 'completed', 'failed', 'deleted'] &&
        data.visibility is string && data.visibility.size() <= 32 && data.visibility in [
          'private',
          'public',
          'followers',
          'subscribers',
          'ppv',
          'message_attachment'
        ] &&
        (!('download_url' in data) || (data.download_url is string && data.download_url.size() <= 2048)) &&
        (!('deleted_at' in data) || (data.deleted_at is string && data.deleted_at.size() <= 64)) &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidUserAccountSettings(data) {
      return data.keys().hasAll([
          'owner_uid',
          'appearance_preference',
          'preferred_language',
          'language_mode',
          'notifications_enabled',
          'email_notifications',
          'privacy_hide_online_status',
          'created_at',
          'updated_at'
        ]) &&
        data.keys().hasOnly([
          'owner_uid',
          'appearance_preference',
          'preferred_language',
          'language_mode',
          'notifications_enabled',
          'email_notifications',
          'privacy_hide_online_status',
          'created_at',
          'updated_at'
        ]) &&
        data.owner_uid is string && data.owner_uid.size() >= 1 && data.owner_uid.size() <= 128 && data.owner_uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.appearance_preference is string && data.appearance_preference.size() <= 16 && data.appearance_preference in ['light', 'dark', 'system'] &&
        data.preferred_language is string && data.preferred_language.size() >= 2 && data.preferred_language.size() <= 16 &&
        data.language_mode is string && data.language_mode.size() <= 16 && data.language_mode in ['automatic', 'manual', 'english'] &&
        data.notifications_enabled is bool &&
        data.email_notifications is bool &&
        data.privacy_hide_online_status is bool &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasAll(['username', 'uid', 'created_at']) &&
        data.keys().hasOnly(['username', 'uid', 'created_at']) &&
        data.username is string && data.username.size() >= 3 && data.username.size() <= 40 && data.username.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.created_at is timestamp;
    }

    function isValidAdminOperatorRecord(data) {
      return data.keys().hasAll(['uid', 'permission_level', 'created_at']) &&
        data.keys().hasOnly(['uid', 'permission_level', 'created_at']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.permission_level is string && data.permission_level.size() <= 32 && data.permission_level in [
          'super_admin', 'admin', 'moderator', 'finance_admin', 'support_admin'
        ] &&
        data.created_at is timestamp;
    }

    function isValidAccountDeletionRequest(data) {
      return data.keys().hasAll([
          'request_id',
          'uid',
          'reason',
          'status',
          'preserve_financial_records',
          'created_at',
          'updated_at'
        ]) &&
        data.keys().hasOnly([
          'request_id',
          'uid',
          'reason',
          'status',
          'preserve_financial_records',
          'created_at',
          'updated_at'
        ]) &&
        data.request_id is string && data.request_id.size() >= 1 && data.request_id.size() <= 128 && data.request_id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500 &&
        data.status is string && data.status.size() <= 24 && data.status in ['pending', 'processing', 'completed', 'cancelled'] &&
        data.preserve_financial_records is bool &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    // =========================================================================
    // 4. COLLECTION MATCH BLOCKS
    // =========================================================================

    // A. Primary User Profiles: /users/{uid}
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      // Registration: Users can only create their own profile with default 'fan' role and 'active' status
      allow create: if isSignedIn() &&
        isValidId(uid) &&
        isOwner(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'fan' &&
        incoming().account_status == 'active' &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        incoming().last_login_at == request.time;

      // Action-Based Update: Owners can only update safe profile/session fields; only Admins can alter role or account_status
      allow update: if isSignedIn() &&
        isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time && (
          isAdmin() || (
            isOwner(uid) &&
            existing().account_status == 'active' &&
            incoming().role == existing().role &&
            incoming().account_status == existing().account_status &&
            incoming().username == existing().username &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'full_legal_name',
              'profile_picture_url',
              'preferred_language',
              'appearance_preference',
              'email_verified',
              'last_login_at',
              'updated_at'
            ])
          )
        );

      allow delete: if isValidId(uid) && isAdmin();

      // B. Isolated User PII Subcollection: /users/{uid}/private/{docId}
      match /private/{docId} {
        allow get: if isValidId(uid) && isValidId(docId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) && existing().uid == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(uid) &&
          isValidId(docId) &&
          isOwner(uid) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().created_at == request.time &&
          incoming().updated_at == request.time &&
          exists(/databases/$(database)/documents/users/$(uid));

        allow update: if isSignedIn() &&
          isValidId(uid) &&
          isValidId(docId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().created_at == existing().created_at &&
          incoming().updated_at == request.time && (
            isAdmin() || (
              isOwner(uid) &&
              isActiveUserAccount(uid) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updated_at'])
            )
          );

        allow delete: if isValidId(uid) && isValidId(docId) && (isOwner(uid) || isAdmin());
      }

      // C. User Personal File Library Metadata: /users/{uid}/files/{fileId}
      match /files/{fileId} {
        allow get: if isValidId(uid) && isValidId(fileId) && (
          isOwner(uid) ||
          isAdmin() ||
          (isSignedIn() && existing().visibility == 'public' && existing().upload_status == 'completed')
        );

        // Strict Query Enforcer: Only owner can list their private file library
        allow list: if isOwner(uid) && existing().owner_uid == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(uid) &&
          isValidId(fileId) &&
          isOwner(uid) &&
          isValidUserFileMetadata(incoming()) &&
          incoming().file_id == fileId &&
          incoming().owner_uid == request.auth.uid &&
          incoming().created_at == request.time &&
          incoming().updated_at == request.time &&
          isActiveUserAccount(uid);

        // Terminal State Lock: Once upload_status reaches 'deleted', non-admins cannot mutate the file record
        allow update: if isSignedIn() &&
          isValidId(uid) &&
          isValidId(fileId) &&
          isValidUserFileMetadata(incoming()) &&
          incoming().file_id == existing().file_id &&
          incoming().owner_uid == existing().owner_uid &&
          incoming().storage_path == existing().storage_path &&
          incoming().mime_type == existing().mime_type &&
          incoming().file_extension == existing().file_extension &&
          incoming().file_size_bytes == existing().file_size_bytes &&
          incoming().created_at == existing().created_at &&
          incoming().updated_at == request.time && (
            isAdmin() || (
              isOwner(uid) &&
              existing().upload_status != 'deleted' &&
              isActiveUserAccount(uid) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'original_filename',
                'upload_status',
                'visibility',
                'download_url',
                'deleted_at',
                'updated_at'
              ])
            )
          );

        allow delete: if isValidId(uid) && isValidId(fileId) && (
          (isOwner(uid) && isActiveUserAccount(uid)) || isAdmin()
        );
      }

      // D. User Account Settings: /users/{uid}/settings/{settingId}
      match /settings/{settingId} {
        allow get: if isValidId(uid) && isValidId(settingId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) && existing().owner_uid == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(uid) &&
          isValidId(settingId) &&
          isOwner(uid) &&
          isValidUserAccountSettings(incoming()) &&
          incoming().owner_uid == request.auth.uid &&
          incoming().created_at == request.time &&
          incoming().updated_at == request.time &&
          isActiveUserAccount(uid);

        allow update: if isSignedIn() &&
          isValidId(uid) &&
          isValidId(settingId) &&
          isValidUserAccountSettings(incoming()) &&
          incoming().owner_uid == existing().owner_uid &&
          incoming().created_at == existing().created_at &&
          incoming().updated_at == request.time && (
            isAdmin() || (
              isOwner(uid) &&
              isActiveUserAccount(uid) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'appearance_preference',
                'preferred_language',
                'language_mode',
                'notifications_enabled',
                'email_notifications',
                'privacy_hide_online_status',
                'updated_at'
              ])
            )
          );

        allow delete: if isValidId(uid) && isValidId(settingId) && (isOwner(uid) || isAdmin());
      }
    }

    // E. Unique Username Registry: /usernames/{username}
    match /usernames/{username} {
      allow get: if isValidId(username);
      allow list: if isSignedIn() && existing().uid == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(username) &&
        isValidUsernameReservation(incoming()) &&
        incoming().username == username &&
        incoming().uid == request.auth.uid &&
        incoming().created_at == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if false;
      allow delete: if isValidId(username) && (
        (isSignedIn() && existing().uid == request.auth.uid) || isAdmin()
      );
    }

    // F. Trusted Administrators Registry: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminOperatorRecord(incoming()) &&
        incoming().uid == adminUid &&
        incoming().created_at == request.time;

      allow update: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminOperatorRecord(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['permission_level']);

      allow delete: if isValidId(adminUid) && isAdmin();
    }

    // G. Account Deletion Requests: /account_deletion_requests/{requestId}
    match /account_deletion_requests/{requestId} {
      allow get: if isValidId(requestId) && (
        (isSignedIn() && existing().uid == request.auth.uid) || isAdmin()
      );
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(requestId) &&
        isValidAccountDeletionRequest(incoming()) &&
        incoming().request_id == requestId &&
        incoming().uid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().preserve_financial_records == true &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // Terminal State Lock: Completed or cancelled deletion requests cannot be modified by users
      allow update: if isSignedIn() &&
        isValidId(requestId) &&
        isValidAccountDeletionRequest(incoming()) &&
        incoming().request_id == existing().request_id &&
        incoming().uid == existing().uid &&
        incoming().preserve_financial_records == existing().preserve_financial_records &&
        incoming().created_at == existing().created_at &&
        incoming().updated_at == request.time && (
          isAdmin() || (
            existing().uid == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at'])
          )
        );

      allow delete: if isValidId(requestId) && isAdmin();
    }
  }
}
