# GEMINI_API_KEY: Required for Gemini AI API calls on server
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Set your project URL and Anon public key from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_STORAGE_BUCKET="app-files"
SUPABASE_SERVICE_ROLE_KEY=""

# CLOUDFLARE STREAM LIVE & SIGNED RECORDING PLAYBACK (Optional for global CDN WHIP/HLS ingest & webhooks)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# WEBRTC TURN / ICE SERVERS FOR RESTRICTIVE NAT & MOBILE NETWORKS
# Option A: Cloudflare Calls TURN API (generates short-lived ephemeral ICE credentials)
CLOUDFLARE_TURN_TOKEN_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
# Option B: Static TURN server URLs (comma-separated) + credentials (e.g. coturn, Twilio NTS, Metered)
TURN_SERVER_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

