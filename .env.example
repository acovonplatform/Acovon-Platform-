# GEMINI_API_KEY: Required for Gemini AI API calls on server
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Set your project URL and Anon public key from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
VITE_SUPABASE_STORAGE_BUCKET="app-files"
